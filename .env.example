# Claude Hi Service Configuration

# Output Settings
OUTPUT_MODE=console  # console or file
# OUTPUT_FILE=/path/to/output.log  # optional, only for file mode

# Message Settings
HI_MESSAGE=hi
HI_INTERVAL=600000  # 10 minutes in milliseconds

# Development Settings (override for dev environment)
DEV_INTERVAL=30000  # 30 seconds for development

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=5000  # 5 seconds between retries

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# Health Check (optional - development only)
HEALTH_PORT=3001  # Port for health check endpoint in dev mode